# Production Environment Configuration
# Copy this to .env.prod and fill in your values

# Database
DB_ROOT_PASSWORD=generate_strong_password_here
DB_DATABASE=pricewatch
DB_USER=pricewatch
DB_PASSWORD=generate_strong_password_here

# Symfony
APP_SECRET=generate_32_char_secret_here

# JWT (generate with: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase

# Email (example with SMTP)
MAILER_DSN=smtp://user:password@smtp.example.com:587

# Frontend
FRONTEND_URL=https://prijswacht.nl
VITE_API_URL=https://api.prijswacht.nl
CORS_ALLOW_ORIGIN=^https://prijswacht\.nl$
